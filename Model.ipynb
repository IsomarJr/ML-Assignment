   "source": [
    "def train(df, model1, model2, n_folds):\n",
    "    preprocessor, X, y = preprocess(df)\n",
    "    cv = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=0)\n",
    "    dataset_metrics = {\n",
    "        'model1': {'Accuracy': [], 'F1 Score': [], 'AUC': []},\n",
    "        'model2': {'Accuracy': [], 'F1 Score': [], 'AUC': []}\n",
    "    }\n",
    "    n_classes = len(np.unique(y))\n",
    "    is_multiclass = n_classes > 2\n",
    "    f1_average = 'weighted' if is_multiclass else 'binary'\n",
    "    for train_index, test_index in cv.split(X, y):\n",
    "        X_train, X_test = X.iloc[train_index], X.iloc[test_index]\n",
    "        y_train, y_test = y[train_index], y[test_index]\n",
    "        X_train = preprocessor.fit_transform(X_train)\n",
    "        X_test = preprocessor.transform(X_test)\n",
    "        model1.fit(X_train, y_train)\n",
    "        model2.fit(X_train, y_train)\n",
    "        m1_y_pred = model1.predict(X_test) \n",
    "        if hasattr(model1, '_predict'):\n",
    "            m1_y_prob = model1._predict(X_test)\n",
    "        else:\n",
    "            m1_y_prob = model1.predict_proba(X_test)\n",
    "        m2_y_pred = model2.predict(X_test)\n",
    "        m2_y_prob = model2.predict_proba(X_test)\n",
    "        for model_name, y_pred, y_prob in [('model1', m1_y_pred, m1_y_prob), ('model2', m2_y_pred, m2_y_prob)]:\n",
    "            dataset_metrics[model_name]['Accuracy'].append(accuracy_score(y_test, y_pred))\n",
    "            dataset_metrics[model_name]['F1 Score'].append(f1_score(y_test, y_pred, average=f1_average))\n",
    "            try:\n",
    "                if is_multiclass:\n",
    "                    auc_score = roc_auc_score(y_test, y_prob, multi_class='ovr')\n",
    "                else:\n",
    "                    prob = y_prob[:, 1] if y_prob.ndim > 1 else y_prob\n",
    "                    auc_score = roc_auc_score(y_test, prob)\n",
    "                dataset_metrics[model_name]['AUC'].append(auc_score)\n",
    "            except ValueError as e:\n",
    "                warnings.warn(f\"AUC calculation failed for a fold: {e}\")\n",
    "                dataset_metrics[model_name]['AUC'].append(np.nan)\n",
    "    avg_metrics = {\n",
    "            model: {\n",
    "                metric: {\"mean\": np.nanmean(values), \"std\": np.nanstd(values)}\n",
    "                for metric, values in model_metrics.items()\n",
    "        } \n",
    "        for model, model_metrics in dataset_metrics.items()\n",
    "    }\n",
    "    return X_train, y_train, avg_metrics, dataset_metrics"
   ]
  },
