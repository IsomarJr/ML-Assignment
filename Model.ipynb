    "class GradientBoosting(BaseEstimator):\n",
    "    def __init__(\n",
    "        self,\n",
    "        n_estimators,\n",
    "        learning_rate=0.1,\n",
    "        max_features=10,\n",
    "        max_depth=2,\n",
    "        min_samples_split=10,\n",
    "        dropout_rate=0.0\n",
    "    ):\n",
    "        self.min_samples_split = min_samples_split\n",
    "        self.learning_rate = learning_rate\n",
    "        self.max_depth = max_depth\n",
    "        self.max_features = max_features\n",
    "        self.n_estimators = n_estimators\n",
    "        self.dropout_rate = dropout_rate \n",
    "        self.trees = []\n",
    "        self.loss = None\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        self.trees = []\n",
    "        self._setup_input(X, y)\n",
    "        self.y_mean = np.mean(y)\n",
    "        self._train()\n",
    "        self.is_fitted_ = True\n",
    "\n",
    "    def _train(self):\n",
    "        for n in range(self.n_estimators):\n",
    "            y_pred = np.zeros(self.n_samples, np.float32)\n",
    "            if len(self.trees) > 0 and self.dropout_rate > 0:\n",
    "                indices = list(range(len(self.trees)))\n",
    "                keep_count = int(len(indices) * (1 - self.dropout_rate))\n",
    "                kept_indices = random.sample(indices, max(1, keep_count))\n",
    "                scale = len(indices) / len(kept_indices)\n",
    "                for i in kept_indices:\n",
    "                    y_pred += self.learning_rate * self.trees[i].predict(self.X) * scale\n",
    "            else:\n",
    "                y_pred = self._predict(self.X)\n",
    "            residuals = self.loss.grad(self.y, y_pred)\n",
    "            tree = Tree(regression=True, criterion=mse_criterion)\n",
    "            targets = {\n",
    "                \"y\": residuals,\n",
    "                \"actual\": self.y,\n",
    "                \"y_pred\": y_pred,\n",
    "            }\n",
    "            tree.train(\n",
    "                self.X,\n",
    "                targets,\n",
    "                max_features=self.max_features,\n",
    "                min_samples_split=self.min_samples_split,\n",
    "                max_depth=self.max_depth,\n",
    "                loss=self.loss,\n",
    "            )\n",
    "            \n",
    "            self.trees.append(tree)\n",
    "\n",
    "    def _predict(self, X=None):\n",
    "        y_pred = np.zeros(X.shape[0], np.float32)\n",
    "        for i, tree in enumerate(self.trees):\n",
    "            y_pred += self.learning_rate * tree.predict(X)\n",
    "        return y_pred\n",
    "\n",
    "    def predict(self, X=None):\n",
    "        return self.loss.transform(self._predict(X))\n",
    "\n",
    "\n",
    "class GradientBoostingRegressor(GradientBoosting):\n",
    "    def fit(self, X, y=None):\n",
    "        self.loss = LeastSquaresLoss()\n",
    "        super(GradientBoostingRegressor, self).fit(X, y)\n",
    "\n",
    "\n",
    "class GradientBoostingClassifier(GradientBoosting):\n",
    "    def fit(self, X, y=None):\n",
    "        y = (y * 2) - 1\n",
    "        self.loss = LogisticLoss()\n",
    "        super(GradientBoostingClassifier, self).fit(X, y)"
   ]
